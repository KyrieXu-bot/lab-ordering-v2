DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=jitri2
PORT=4000
JWT_SECRET=change_me
SAMPLE_FLOW_SCAN_URL=http://192.168.9.46:3004/sample-flow/scan
# 推荐生产环境安装 LibreOffice，并填写 soffice 可执行文件的绝对路径。
# Windows 示例：SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
# Linux 示例：SOFFICE_PATH=/usr/bin/soffice
SOFFICE_PATH=

# 可选：让 Ubuntu 把 DOCX 发送到局域网 Windows 电脑，用 Microsoft Word 生成 PDF。
PDF_CONVERSION_SERVICE_URL=http://192.168.9.100:4317
PDF_CONVERSION_SERVICE_KEY=replace_with_the_same_long_random_secret
PDF_CONVERSION_SERVICE_TIMEOUT_MS=120000
# 设为 1 时，Windows 节点不可用就报错，不再回退到版式可能不同的 LibreOffice。
PDF_CONVERSION_REMOTE_REQUIRED=1
